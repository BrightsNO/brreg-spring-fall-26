    {
      "name": "14 Tampered token (signature changed)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Change a few characters in the middle of the signature",
              "const t = pm.collectionVariables.get(\"userToken\");",
              "const i = t.lastIndexOf(\".\") + 5;",
              "const c = t.charAt(i) === \"A\" ? \"B\" : \"A\";",
              "pm.collectionVariables.set(\"tamperedToken\", t.substring(0, i) + c + t.substring(i + 1));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/companies",
          "host": [
            "{{baseUrl}}"
          ],
