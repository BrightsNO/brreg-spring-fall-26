    {
      "name": "16 Tampered machine token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = pm.collectionVariables.get(\"machineToken\");",
              "const i = t.lastIndexOf(\".\") + 5;",
              "const c = t.charAt(i) === \"A\" ? \"B\" : \"A\";",
              "pm.collectionVariables.set(\"tamperedToken\", t.substring(0, i) + c + t.substring(i + 1));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/companies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "companies"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tamperedToken}}",
              "type": "string"
            }
          ]
        }
      }
