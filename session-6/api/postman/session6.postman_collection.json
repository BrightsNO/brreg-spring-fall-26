{
  "info": {
    "name": "Session 6: OAuth2 and resource server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Expected statuses describe the SOLVED state (after tasks 6.3 and 6.4). Run 02 first: it saves machineToken. userToken, adminReadToken (scope companies.read only) and adminToken (scopes companies.read and companies.write) are pasted into the collection variables after you have fetched them with the OAuth 2.0 tab."
  },
  "item": [
    {
      "name": "00 Discovery document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Has jwks_uri\", function () { pm.expect(pm.response.json().jwks_uri).to.be.a(\"string\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{authUrl}}/.well-known/openid-configuration",
          "host": [
            "{{authUrl}}"
          ],
          "path": [
            ".well-known",
            "openid-configuration"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "01 Public keys (JWKS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{authUrl}}/oauth2/jwks",
          "host": [
            "{{authUrl}}"
          ],
          "path": [
            "oauth2",
            "jwks"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Get machine token (Client Credentials)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const token = pm.response.json().access_token;",
              "pm.test(\"Response has an access_token\", function () { pm.expect(token).to.be.a(\"string\"); });",
              "pm.collectionVariables.set(\"machineToken\", token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{authUrl}}/oauth2/token",
          "host": [
            "{{authUrl}}"
          ],
          "path": [
            "oauth2",
            "token"
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{machineClient}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{machineSecret}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "scope",
              "value": "companies.read"
            }
          ]
        }
      }
    },
    {
      "name": "03 Public info (no token)",
      "event": [
